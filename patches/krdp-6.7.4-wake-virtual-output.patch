 private:
+    void wakeVirtualOutput()
+    {
+        if (m_virtualOutputWoken || !connection || connection->state() != KRdp::RdpConnection::State::Streaming) {
+            return;
+        }
+        const auto screens = QGuiApplication::screens();
+        if (screens.size() != 1 || screens.constFirst()->name() != u"Virtual-0"_s) {
+            return;
+        }
+        m_virtualOutputWoken = true;
+        m_dpms->switchMode(KScreen::Dpms::On, screens);
+        qInfo() << "KRdp: requested DPMS on for dedicated Virtual-0";
+    }
