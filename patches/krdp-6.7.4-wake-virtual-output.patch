+        // A persistent headless desktop can be DPMS-off while disconnected.
+        // Wake only our dedicated virtual output after authenticated GFX setup.
+        connect(connection, &KRdp::RdpConnection::stateChanged, this, [this](KRdp::RdpConnection::State state) {
+            if (state != KRdp::RdpConnection::State::Streaming || m_dpms
+                || qEnvironmentVariableIntValue("PLASMA_RDP_RESIZE_VIRTUAL_OUTPUT") != 1) {
+                return;
+            }
+            const auto screens = QGuiApplication::screens();
+            if (screens.size() != 1 || screens.constFirst()->name() != u"Virtual-0"_s) {
+                return;
+            }
+            m_dpms = new KScreen::Dpms(this);
+            connect(m_dpms, &KScreen::Dpms::supportedChanged, this, [this](bool supported) {
+                if (supported) {
+                    wakeVirtualOutput();
+                }
+            });
+            if (m_dpms->isSupported()) {
+                wakeVirtualOutput();
+            }
+        }, Qt::QueuedConnection);
