+private:
+    enum class ResizeStep {
+        FindMode,
+        SelectNewMode,
+        VerifyMode,
+    };
+
+    void resizeFinished()
+    {
+        m_resizeInProgress = false;
+        if (m_pendingSize.isValid() && !m_resizeTimer.isActive()) {
+            m_resizeTimer.start();
+        }
+    }
+
+    void applyOutput(const KScreen::ConfigPtr &config, const QSize &size, bool addedMode)
+    {
+        auto operation = new KScreen::SetConfigOperation(config, this);
+        connect(operation, &KScreen::ConfigOperation::finished, this, [this, operation, size, addedMode] {
+            if (operation->hasError()) {
+                qWarning() << "KRdp: could not apply display mode" << size << operation->errorString();
+                resizeFinished();
+            } else if (addedMode) {
+                readOutput(size, ResizeStep::SelectNewMode);
+            } else {
+                readOutput(size, ResizeStep::VerifyMode);
+            }
+        });
+    }
+
+    void readOutput(const QSize &size, ResizeStep step)
+    {
+        if (!size.isValid() || !connection || connection->state() != KRdp::RdpConnection::State::Streaming) {
+            resizeFinished();
+            return;
+        }
+
+        m_resizeInProgress = true;
+        auto operation = new KScreen::GetConfigOperation(KScreen::GetConfigOperation::NoEDID, this);
+        connect(operation, &KScreen::ConfigOperation::finished, this, [this, operation, size, step] {
+            const auto config = operation->config();
+            const auto outputs = config ? config->connectedOutputs() : KScreen::OutputList();
+            const auto output = outputs.size() == 1 ? outputs.constBegin().value() : KScreen::OutputPtr();
+            if (!connection || connection->state() != KRdp::RdpConnection::State::Streaming || operation->hasError()
+                || !output || output->name() != u"Virtual-0"_s || !output->isEnabled()
+                || !(output->capabilities() & KScreen::Output::Capability::CustomModes) || !output->currentMode()) {
+                resizeFinished();
+                return;
+            }
+            if (step == ResizeStep::VerifyMode) {
+                const auto actualSize = output->currentMode()->size();
+                if (actualSize == size) {
+                    qInfo() << "KRdp: applied virtual output mode" << size;
+                    // KPipeWire 6.7 configures its encoder only on the first PipeWire format.
+                    m_sessionStarted = false;
+                    connection->videoStream()->setStreamingEnabled(false);
+                    session->start();
+                } else {
+                    qWarning() << "KRdp: virtual output remained at" << actualSize << "after requesting" << size;
+                }
+                resizeFinished();
+                return;
+            }
+            if (output->currentMode()->size() == size) {
+                resizeFinished();
+                return;
+            }
+
+            // Only the dedicated virtual output is managed by the RDP service. Keep its
+            // current custom mode until KWin has generated and advertised the new one.
+            const auto customModes = output->customModes();
+            const auto modes = output->modes();
+            for (const auto &mode : modes) {
+                if (mode->size() != size) {
+                    continue;
+                }
+                output->setCurrentModeId(mode->id());
+                applyOutput(config, size, false);
+                return;
+            }
+
+            if (step == ResizeStep::SelectNewMode) {
+                qWarning() << "KRdp: KWin did not advertise the requested display mode" << size;
+                resizeFinished();
+                return;
+            }
+            QList<KScreen::ModeInfo> retainedModes;
+            for (const auto &custom : customModes) {
+                if (custom.size == output->currentMode()->size() && custom.refreshRate == output->currentMode()->refreshRate()) {
+                    retainedModes.append(custom);
+                    break;
+                }
+            }
+            retainedModes.append(KScreen::ModeInfo{
+                .size = size,
+                .refreshRate = 60.0f,
+                .flags = KScreen::ModeInfo::Flags(KScreen::ModeInfo::Flag::Custom) | KScreen::ModeInfo::Flag::ReducedBlanking,
+            });
+            output->setCustomModes(retainedModes);
+            applyOutput(config, size, true);
+        });
