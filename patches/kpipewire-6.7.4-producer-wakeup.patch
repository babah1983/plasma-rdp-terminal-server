--- /dev/null
+++ b/src/producerwakeup_p.h
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+#pragma once
+
+#include <condition_variable>
+#include <mutex>
+
+// A latched wakeup: work and shutdown are remembered even before wait().
+// One consumer per gate; notifications can be coalesced because encoders drain
+// their queues. Closing is terminal for this producer's lifetime.
+class PipeWireProducerWakeup
+{
+public:
+    void notify()
+    {
+        {
+            std::lock_guard lock(m_mutex);
+            m_pending = true;
+        }
+        m_condition.notify_one();
+    }
+
+    bool wait()
+    {
+        std::unique_lock lock(m_mutex);
+        m_condition.wait(lock, [this] { return m_pending || m_closed; });
+        if (m_closed) {
+            return false;
+        }
+        m_pending = false;
+        return true;
+    }
+
+    void close()
+    {
+        {
+            std::lock_guard lock(m_mutex);
+            m_closed = true;
+        }
+        m_condition.notify_one();
+    }
+
+private:
+    std::mutex m_mutex;
+    std::condition_variable m_condition;
+    bool m_pending = false;
+    bool m_closed = false;
+};
