[Unit]
Description=KRdp transport for the Plasma Login Manager greeter
PartOf=plasma-login-wayland.target
After=plasma-login-kwin_wayland.service
Requires=plasma-login-kwin_wayland.service

[Service]
Environment=QT_QPA_PLATFORM=wayland
Environment=WAYLAND_DISPLAY=wayland-0
Environment=KPIPEWIRE_FORCE_ENCODER=libx264
Environment=PLASMA_RDP_LAB_NLA=1
Environment=PLASMA_RDP_REDIRECT_FILE=%t/plasma-rdp-route
Environment=PLASMA_RDP_DISABLE_DMABUF=1
Environment=LD_LIBRARY_PATH=/opt/system-kpipewire-shm/lib:/opt/system-krdp/lib
WorkingDirectory=%h/.local/state/plasma-rdp
ExecStart=/usr/local/libexec/plasma-rdp-greeter
Restart=on-failure

[Install]
WantedBy=plasma-login-wayland.target
